# Supabase — pegue em Project Settings > API no painel do Supabase do seu amigo
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave de servico (service_role) — NUNCA exponha no client. Usada nas rotas de API do admin.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Senha do painel admin
ADMIN_PASSWORD=troque-esta-senha

# Segredo para assinar o cookie de sessao do admin (qualquer string longa aleatoria)
ADMIN_SESSION_SECRET=gere-uma-string-aleatoria-bem-longa-aqui
